{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sign-shop-funnel",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-22",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sign-shop-leads",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "ARTWORK",
      "bucket_name": "sign-shop-artwork"
    }
  ],

  "vars": {
    "TURNSTILE_SITE_KEY": "REPLACE_WITH_TURNSTILE_SITE_KEY",
    "LEAD_EMAIL_TO": "quotes@example.com",
    "LEAD_EMAIL_FROM": "quotes@example.com",
    "BUSINESS_NAME": "Your Sign & Print Shop"
  }
}
