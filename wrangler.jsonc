{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dahntahn-made",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dahntahn-made-leads",
      "database_id": "7b701c35-b5f9-4c43-bdcc-78be26a23153"
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "dahntahn-made-artwork",
      "binding": "ARTWORK"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEdOzr_sd_HH5fdK",
    "LEAD_EMAIL_TO": "ibuckman@dtmade.net",
    "LEAD_EMAIL_FROM": "quotes@dtmade.net",
    "BUSINESS_NAME": "Dahntahn Made",
    "SITE_URL": "https://dtmade.net",
    "ARTWORK_LINK_TTL_SECONDS": "2592000"
  },
  "routes": [
    {"pattern": "dtmade.net", "custom_domain": true},
    {"pattern": "www.dtmade.net", "custom_domain": true}
  ]
}
